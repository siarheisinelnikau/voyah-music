<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".PlayerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/music_data_rules"
        android:icon="@drawable/ic_voyah_music"
        android:label="@string/player_name"
        android:theme="@style/MusicTheme">
        <activity android:name=".ui.PlayerActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".playback.PlaybackService" android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- The head unit's home screen media card connects here. The permission is a platform one that only system
             apps hold (the launcher runs as the system uid); onGetRoot also accepts only the system uid. -->
        <service android:name=".playback.MusicBrowserService" android:exported="true"
            android:permission="android.permission.MEDIA_CONTENT_CONTROL">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>
</manifest>
